# ==========================================================================
# ValueInvestor — LLM provider selection
# Uncomment ONE provider block.  The env vars always override config.yaml.
# ==========================================================================

# --- DeepSeek (ACTIVE — default provider) ---
# Uses DeepSeek's OpenAI-compatible API endpoint.
# Default model: DeepSeek-V4-Flash
LLM_PROVIDER=deepseek
LLM_MODEL=DeepSeek-V4-Pro
LLM_BASE_URL=https://api.deepseek.com/v1

# --- GitHub Models (models.github.ai) ---
# Uses GitHub Models marketplace endpoint.
# Available models: openai/gpt-4.1, openai/gpt-4o, anthropic/claude-sonnet-4-5
# LLM_PROVIDER=github
# LLM_MODEL=openai/gpt-4.1
# LLM_BASE_URL=https://models.github.ai/inference

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=

# --- Gemini (fallback — used when GITHUB_TOKEN is not set) ---
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3-flash-preview
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- OpenRouter ---
# LLM_PROVIDER=openrouter
# LM_MODEL=anthropic/claude-opus-4.7
# LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Kimi ---
# LLM_PROVIDER=kimi
# LLM_MODEL=Kimi Code 2.5
# LLM_BASE_URL=https://api.moonshot.cn/v1

# --- NVIDIA NIM (Minimax M2.7) ---
#LLM_PROVIDER=nvidia_nim
#LLM_MODEL=deepseek-v4-pro
#LLM_BASE_URL=https://api.studio.nvidia.com/v1

# --- Local LLM (e.g., LM Studio) ---
# Used ONLY for improve_scorer/trainer. Falls back to primary provider if unavailable.
# Set LOCAL_LLM_ENABLED=true to use local LLM for trainer, with fallback to primary.
# LOCAL_LLM_BASE_URL should point to the local LLM server (default: http://127.0.0.1:1234)
# LOCAL_LLM_MODEL is the model name available on the local server (e.g., "qwen-7b", "llama2-7b")
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234
LOCAL_LLM_MODEL=default_model

# ==========================================================================
# API Keys
# ==========================================================================

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# GitHub — primary key for Copilot and GitHub Models.
# Set this to your GitHub personal-access-token with Copilot subscription.
# Get one at: https://github.com/settings/tokens (needs copilot scope)
GITHUB_TOKEN=
# Legacy alias (also accepted as fallback)
GITHUB_API_KEY=

OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
# Fallback Gemini model (used when GitHub Copilot token is unavailable)
GEMINI_MODEL=gemini-3-flash-preview
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
KIMI_API_KEY=your-kimi-api-key-here
NVIDIA_NIM_API_KEY=nvapi-your-nvidia-nim-api-key-here
NVIDIA_NIM_BASE_URL=https://api.studio.nvidia.com/v1
